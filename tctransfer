#!/usr/bin/env bash
#
# tctransfer — wrapper interactivo y minimalista de tailcat.
#
# Elija un lado (exponer o conectar) y una acción (SSH o archivos). Nada más.
# tailcat: https://github.com/tailscale/tailcat
#
# Ejecutar:
#   ./tctransfer
#   bash <(curl -fsSL <raw-url>)
#   curl -fsSL <raw-url> | bash        # los menús funcionan igual: lee del terminal
#
# Variables de entorno:
#   TAILCAT_BIN   ruta al binario de tailcat   (por defecto: tailcat)
#   TCT_SSH_KEYS  authorized_keys para servir   (por defecto: ~/.ssh/authorized_keys)
#
set -euo pipefail

TAILCAT_BIN="${TAILCAT_BIN:-tailcat}"
SSH_KEYS="${TCT_SSH_KEYS:-$HOME/.ssh/authorized_keys}"

# La ayuda va primero, antes de tocar el terminal (funciona en cualquier contexto).
case "${1:-}" in
  -h|--help)
    # Imprime el bloque de comentarios del encabezado (salta el shebang, corta en la primera línea de código).
    awk 'NR==1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    exit 0
    ;;
esac

# Cuando se usa como `curl ... | bash`, stdin es el propio script, así que los
# prompts leerían los bytes del script. Redirigimos las lecturas al terminal
# real, pero solo si realmente se puede abrir (algunos sandboxes tienen
# /dev/tty pero no lo pueden abrir).
if [ ! -t 0 ] && ( : </dev/tty ) 2>/dev/null; then
  exec </dev/tty
fi

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
run()  { printf '\n+ %s\n\n' "$*" >&2; "$@"; }

require_tailcat() {
  command -v "$TAILCAT_BIN" >/dev/null 2>&1 || die \
    "tailcat no se encontró en el PATH. Instálelo desde: https://github.com/tailscale/tailcat"
}

# prompt "pregunta" [valor-por-defecto] -> imprime la respuesta
prompt() {
  local q="$1" def="${2:-}" ans
  if [ -n "$def" ]; then
    read -r -p "$q [$def]: " ans || true
    printf '%s' "${ans:-$def}"
  else
    read -r -p "$q: " ans || true
    printf '%s' "$ans"
  fi
}

# choose "título" opc1 opc2 ... -> imprime el texto de la opción elegida
choose() {
  local title="$1"; shift
  local opt
  printf '\n%s\n' "$title" >&2
  select opt in "$@"; do
    [ -n "${opt:-}" ] && { printf '%s' "$opt"; return 0; }
    printf 'Elija uno de los números.\n' >&2
  done
}

expose() {
  local what
  what=$(choose "¿Qué desea exponer?" \
    "Acceso SSH" \
    "Recibir archivos (buzón)" \
    "Compartir carpeta (solo lectura)")

  case "$what" in
    "Acceso SSH")
      [ -r "$SSH_KEYS" ] || die "no hay authorized_keys en $SSH_KEYS (configure TCT_SSH_KEYS)"
      # Imprime una dirección tcXXXX; pásela a quien se conecte.
      run "$TAILCAT_BIN" serve --ssh-authorized-keys="$SSH_KEYS" ssh
      ;;
    "Recibir archivos (buzón)")
      local dir; dir=$(prompt "Carpeta de entrada" "$HOME/inbox")
      mkdir -p "$dir"
      run "$TAILCAT_BIN" recv "$dir"
      ;;
    "Compartir carpeta (solo lectura)")
      local dir; dir=$(prompt "Carpeta a compartir" "$PWD")
      [ -d "$dir" ] || die "no existe el directorio: $dir"
      # `serve files` comparte el directorio actual en solo lectura.
      ( cd "$dir" && run "$TAILCAT_BIN" serve files )
      ;;
  esac
}

connect() {
  local addr; addr=$(prompt "Dirección tailcat (tcXXXX)")
  [ -n "$addr" ] || die "se requiere una dirección"

  local what
  what=$(choose "¿Qué desea hacer?" \
    "Abrir una sesión SSH" \
    "Enviar un archivo" \
    "Traer un archivo" \
    "Listar archivos remotos")

  case "$what" in
    "Abrir una sesión SSH")
      run "$TAILCAT_BIN" ssh "$addr"
      ;;
    "Enviar un archivo")
      local f; f=$(prompt "Archivo local a enviar")
      [ -f "$f" ] || die "no existe el archivo: $f"
      run "$TAILCAT_BIN" cp "$f" "$addr:"
      ;;
    "Traer un archivo")
      local rf df
      rf=$(prompt "Ruta remota")
      df=$(prompt "Guardar en" "$PWD")
      run "$TAILCAT_BIN" cp "$addr:$rf" "$df"
      ;;
    "Listar archivos remotos")
      run "$TAILCAT_BIN" ls -l "$addr"
      ;;
  esac
}

main() {
  require_tailcat

  local side
  side=$(choose "tctransfer — elija un lado:" \
    "Exponer (esta máquina sirve)" \
    "Conectar (a una dirección tcXXXX)")

  case "$side" in
    "Exponer"*)  expose ;;
    "Conectar"*) connect ;;
  esac
}

main "$@"
